# ARIV environment configuration
# Copy this file to `.env` for local development:  cp .env.example .env
# These values are safe LOCAL defaults. For production (Render), set the
# variables from the Environment Variables table in docs/DEPLOYMENT_RENDER.md.
# Never commit real secrets.

# --- Infrastructure (local defaults) ---
# Local docker-compose swaps these per-service via its own environment block;
# these are the bare-local (no docker) conveniences.
DATABASE_URL=postgresql+asyncpg://ariv_user:ariv_pass@localhost:5432/ariv_db
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=            # set ONLY if your Qdrant cluster requires a key
QDRANT_COLLECTION_NAME=historical_cases
EMBEDDING_DIMENSION=768

# Background KnowledgeOutbox drainer sweep interval (seconds).
KNOWLEDGE_DRAIN_INTERVAL_SECONDS=30.0
# Set KNOWLEDGE_DRAIN_ENABLED=false on the Render web service when a dedicated
# worker service owns the drainer.
KNOWLEDGE_DRAIN_ENABLED=true

# --- Security & Provider Credentials (LOCAL demo values) ---
INTERNAL_API_KEY=test_internal_key
RAZORPAY_WEBHOOK_SECRET=test_secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ENVIRONMENT=SANDBOX
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Demo mode binds the demo account to a tenant at startup (local developer UX).
DEMO_MODE=true
DEMO_ACCOUNT_ID=acc_demo_123

# --- LLM (optional / agent explainability) ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini